# Copy to .env and fill in. Never commit .env.

# MongoDB. Must be a replica set (transactions are required):
#   - MongoDB Atlas (free tier works): mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
#   - Local: run "docker compose up -d" in the project root, then use the URI below.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=expense_review

# Login for the reviewer area. CHANGE ALL THREE before running anywhere real.
# JWT_SECRET: a long random string, e.g. the output of
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# The admin account is created from these on first start, only if it does not
# exist yet. Changing them later does not change an existing password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-first-start

# Leave empty to run with the built-in mock AI (clearly labelled in the UI and logs).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=30000

PORT=3001
LOG_LEVEL=info
